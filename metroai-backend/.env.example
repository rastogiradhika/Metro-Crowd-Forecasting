# ============================================================
# METROAI BACKEND — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure your secrets:
# cp .env.example .env
# ============================================================

ENVIRONMENT=development
PROJECT_NAME="MetroAI Backend"
API_V1_STR=/api

# Database Connection Configuration:
# ------------------------------------------------------------
# 1. LOCAL DEVELOPMENT & TESTING:
#    Use SQLite for quick, zero-config local runs. Defaults to a local file in the project root.
#    Note: SQLite enforces Foreign Keys via PRAGMA foreign_keys=ON in database.py.
DATABASE_URL=sqlite:///./metroai.db

# 2. PRODUCTION DEPLOYMENT (Render, Neon, Supabase, AWS RDS, Docker):
#    REQUIRED FOR PRODUCTION: Must be a PostgreSQL connection URL.
#    SQLite must NOT be used in production because it causes file locking under concurrent requests.
#    Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
#    Note: If Render provides a 'postgres://' URI, database.py will automatically normalize it to 'postgresql://'.
# DATABASE_URL=postgresql://metroai_user:your_secure_db_password@dpg-xxxxxx.render.com/metroaidb

# JWT Security (REQUIRED: min 32 characters, fail-closed if missing)
# Generate a secure key in shell: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_GENERATE_VIA_OPENSSL_RAND_HEX_32_MIN_32_CHARS_REQUIRED

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME=access_token

# Initial Admin Credentials (Optional: used for automatic first-time provisioning)
ADMIN_EMAIL=admin@delhimetrorail.com
ADMIN_PASSWORD=your_secure_admin_password_here

# CORS Allowed Origins (Comma-separated exact origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://metroai.vercel.app

# ML Weights Directory
MODELS_DIR=./models_weights
