# ============================================================
# METROAI FRONTEND — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env or .env.local and configure:
# cp .env.example .env.local
# ============================================================

# Backend API base URL:
# For local dev without proxy: http://localhost:8000
# For local dev with Vite proxy or production Vercel rewrites: leave empty ""
VITE_API_BASE_URL=http://localhost:8000

# Demo Mode toggle (Set strictly to 'true' to force mock simulation)
VITE_DEMO_MODE=false
